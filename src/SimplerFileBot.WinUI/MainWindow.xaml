<Window
    x:Class="SimplerFileBot.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Rename" Tag="rename" />
                <NavigationViewItem Content="Formats" Tag="formats" />
                <NavigationViewItem Content="Metadata" Tag="metadata" />
                <NavigationViewItem Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>
            <Grid Padding="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="Notice" Grid.Row="0" Margin="0,0,0,12" IsOpen="False" IsClosable="True" />
                <Grid x:Name="RenameView" Grid.Row="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Rename" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Add media, match titles, review every destination, then rename."
                                       Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add files" Click="AddFiles_Click" />
                        <Button Content="Add folder" Click="AddFolder_Click" />
                        <Button Content="Remove checked" Click="RemoveChecked_Click" />
                        <Button Content="Clear" Click="Clear_Click" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
                        <ProgressRing x:Name="BusyRing" Width="28" Height="28" IsActive="False" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceCombo" Header="Metadata source" HorizontalAlignment="Stretch"
                                  SelectionChanged="SourceCombo_SelectionChanged">
                            <ComboBoxItem Content="TVMaze" />
                            <ComboBoxItem Content="TheMovieDB" />
                            <ComboBoxItem Content="OMDB" />
                            <ComboBoxItem Content="Local metadata" />
                        </ComboBox>
                        <TextBox x:Name="TitleBox" Grid.Column="1" Header="Title override (optional)" PlaceholderText="Use detected title" />
                        <TextBox x:Name="YearBox" Grid.Column="2" Header="Year override (optional)" PlaceholderText="Auto" />
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox x:Name="AbsoluteCheck" Content="Absolute TV episode order" />
                        <Button x:Name="MatchButton" Content="Match metadata" Click="Match_Click" />
                        <Button x:Name="RenameButton" Content="Rename checked" Click="Rename_Click" />
                        <Button x:Name="UndoButton" Content="Undo last rename" Click="Undo_Click" IsEnabled="False" />
                    </StackPanel>
                    <Grid Grid.Row="4" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="14,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="ORIGINAL" />
                            <TextBlock Grid.Column="2" Text="NEW NAME" />
                            <TextBlock Grid.Column="3" Text="STATUS" />
                        </Grid>
                        <ListView x:Name="PreviewList" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="12" MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Tag="{Binding}" Checked="RowSelection_Changed" Unchecked="RowSelection_Changed" />
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Item.SourcePath}" />
                                        <TextBox Grid.Column="2" Text="{Binding ProposedName, Mode=TwoWay}" Tag="{Binding}"
                                                 TextChanged="ProposedName_TextChanged" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="WrapWholeWords"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <TextBlock x:Name="SummaryText" Grid.Row="5" Text="No files added" Opacity="0.7" />
                </Grid>

                <ScrollViewer x:Name="FormatsView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Formats" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Choose filenames using the placeholders below. Extensions are retained automatically." TextWrapping="Wrap" />
                        <TextBox x:Name="MovieFormatBox" Header="Movie format" TextChanged="Format_TextChanged" />
                        <TextBlock Text="{}{movie_name}  {year}" />
                        <TextBlock x:Name="MovieExample" />
                        <TextBox x:Name="SeriesFormatBox" Header="Series format" TextChanged="Format_TextChanged" />
                        <TextBlock Text="{}{series_name}  {year}  {season_number}  {episode_number}  {episode_title}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SeriesExample" />
                        <Button Content="Save formats" Click="SaveFormats_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="MetadataView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Metadata" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="TVMaze and local matching need no key. TheMovieDB and OMDB keys are stored on this PC." TextWrapping="Wrap" />
                        <PasswordBox x:Name="TmdbKeyBox" Header="TheMovieDB API key" />
                        <PasswordBox x:Name="OmdbKeyBox" Header="OMDB API key" />
                        <Button Content="Save API keys" Click="SaveKeys_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeCombo" Header="Theme" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                        <ToggleSwitch x:Name="FilenameOnlySwitch" Header="Analyze filenames only" Toggled="FilenameOnlySwitch_Toggled" />
                        <TextBlock Text="Excluded folders are ignored when finding titles and years from parent folders." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ExcludedFolderBox" PlaceholderText="C:\Media\Unsorted" Width="440" />
                            <Button Content="Add excluded folder" Click="AddExcluded_Click" />
                        </StackPanel>
                        <ListView x:Name="ExcludedList" Height="150" SelectionMode="Single" />
                        <Button Content="Remove selected folder" Click="RemoveExcluded_Click" HorizontalAlignment="Left" />
                        <Button Content="Open settings folder" Click="OpenSettings_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
